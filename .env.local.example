# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase project URL and anon/public key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — server-only, bypasses Row Level Security.
# Never prefix with NEXT_PUBLIC_, never import into a Client Component.
SUPABASE_SERVICE_ROLE_KEY=

# Temporary shared secret for /admin/* routes (v0.8 placeholder, not real auth).
ADMIN_TOKEN=
